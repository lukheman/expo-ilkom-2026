{
    "name": "akmal/mini-mvc-ku",
    "description": "Mini MVC Framework with Twig and Eloquent",
    "type": "project",
    "require": {
        "twig/twig": "^3.0",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "authors": [
        {
            "name": "Akmal",
            "email": "akmal@example.com"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.32",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "scripts": {
        "format": "./vendor/bin/pint",
        "format:test": "./vendor/bin/pint --test",
        "format:twig": "./vendor/bin/twig-cs-fixer fix",
        "format:twig:test": "./vendor/bin/twig-cs-fixer lint"
    }
}
