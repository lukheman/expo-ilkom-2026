{% extends 'layout.twig' %}
{% block content %}
  <div class="gf-container" style="max-width:760px">
    <h1 class="gf-h2"><i class="bi bi-basket"></i> Keranjang</h1>
    {% if (groups|length) == 0 %}
      <div class="text-center py-5">
        <div style="font-size:4rem">
          <i class="bi bi-basket"></i>
        </div>
        <h3>Keranjang masih kosong</h3>
        <p class="text-secondary">
          Pilih menu lalu tekan <strong>Tambah</strong>.
        </p><a href="/" class="btn btn-primary">Lihat menu</a>
      </div>
    {% else %}
      {% for g in groups %}
        <div class="card p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <strong>
              {% if g.store and g.store.photo %}
                <img
                  src="{{ g.store.photo|e }}"
                  alt=""
                  style="width:32px;height:32px;object-fit:cover;border-radius:50%;vertical-align:middle"
                />
              {% else %}
                <i class="bi bi-shop"></i>
              {% endif %}
              {{ g.store ? g.store.name : 'Stan' }}
            </strong>
            <span class="badge bg-secondary">Stan {{ g.store and g.store.booth_number ? g.store.booth_number : '—' }}</span>
          </div>
          {% for p in g.items %}
            <div class="d-flex gap-3 py-3 border-bottom align-items-start">
              {% if p.image %}
                <img
                  src="{{ p.image|e }}"
                  alt="{{ p.name|e }}"
                  style="width:56px;height:56px;object-fit:cover;border-radius:12px;flex:0 0 auto"
                />
              {% endif %}
              <div class="flex-fill">
                <div class="fw-bold">{{ p.name }}</div>
                <small class="text-secondary">Rp {{ p.price|number_format(0, ',', '.') }}</small>
                <div class="d-flex align-items-center justify-content-between mt-2">
                  <span class="d-inline-flex align-items-center gap-2">
                    <form method="post" action="/home/cartUpdate" class="m-0">
                      <input type="hidden" name="product_id" value="{{ p.id }}" />
                      <input type="hidden" name="qty" value="{{ p.qty - 1 }}" />
                      <button class="gf-step" title="Kurangi">−</button>
                    </form>
                    <b>{{ p.qty }}</b>
                    <form method="post" action="/home/cartUpdate" class="m-0">
                      <input type="hidden" name="product_id" value="{{ p.id }}" />
                      <input type="hidden" name="qty" value="{{ p.qty + 1 }}" />
                      <button class="gf-step" title="Tambah">+</button>
                    </form>
                  </span>
                  <strong>Rp {{ p.subtotal|number_format(0, ',', '.') }}</strong>
                </div>
              </div>
              <a
                class="btn btn-sm btn-danger"
                href="/home/cartRemove/{{ p.id }}"
                onclick="return confirm('Hapus dari keranjang?')"
                title="Hapus"
              >
                <i class="bi bi-trash"></i>
              </a>
            </div>
          {% endfor %}
          <div class="d-flex justify-content-between pt-2">
            <span class="text-secondary">Subtotal stan</span><strong>Rp {{ g.subtotal|number_format(0, ',', '.') }}</strong>
          </div>
          <a href="/home/checkout?store={{ g.store_id }}" class="btn btn-primary w-100 mt-2">
            Checkout — Rp {{ g.subtotal|number_format(0, ',', '.') }}
          </a>
        </div>
      {% endfor %}
      <a href="/" class="btn btn-secondary w-100">Belanja lagi</a>
    {% endif %}
  </div>
{% endblock %}
