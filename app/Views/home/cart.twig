{% extends "layout.twig" %}{% block content %}<div class="gf-container"><h1 class="gf-h2">Keranjang Belanja</h1>{% if cart %}<div class="row"><div class="col-lg-8">{% for p in cart %}<div class="card p-3 mb-3 d-flex flex-row align-items-center gap-3"><img src="{{ p.image }}" width="90" height="75" style="object-fit:cover;border-radius:12px"><div class="flex-grow-1"><h5 style="margin:0">{{ p.name }}</h5><div style="font-size:13px;color:#666">{{ p.size_opt|default('Reguler') }} • {{ p.ice_opt|default('Es Normal') }}</div><div>{{ p.qty }} × Rp {{ p.unit_price|default(p.price)|number_format(0,',','.') }}</div></div><strong class="price">Rp {{ p.subtotal|number_format(0,',','.') }}</strong></div>{% endfor %}</div><div class="col-lg-4"><div class="card p-4"><h5>Total</h5><h2 class="price">Rp {{ total|number_format(0,',','.') }}</h2><a href="/home/checkout?total={{ total }}" class="btn btn-primary w-100 mt-3">Lanjut Checkout</a><a href="/" class="btn btn-link w-100 mt-2">+ Tambah lagi</a></div></div></div>{% else %}<div class="text-center py-5"><div style="font-size:5rem">🛒</div><h3>Keranjang masih kosong</h3><a href="/" class="btn btn-primary">Mulai belanja</a></div>{% endif %}</div>{% endblock %}
