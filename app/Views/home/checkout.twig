{% extends "layout.twig" %}{% block content %}<h1 class="fw-bold mb-4">Checkout</h1><div class="card p-4" style="max-width:700px"><form method="post"><label class="form-label">Nama penerima</label><input class="form-control mb-3" name="name" required><label class="form-label">Alamat pengiriman</label><textarea class="form-control mb-3" name="address" required></textarea><label class="form-label">Metode pembayaran</label><select class="form-select mb-3" name="payment"><option>Transfer Bank</option><option>COD</option><option>E-wallet</option></select><label class="form-label">Catatan</label><textarea class="form-control mb-4" name="note"></textarea><button class="btn btn-primary w-100">Buat Pesanan</button></form></div>{% endblock %}
