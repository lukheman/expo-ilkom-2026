{% extends 'layout.twig' %}
{% block content %}
  <div class="gf-container" style="max-width:760px">
    <div class="d-flex justify-content-between align-items-center">
      <h1 class="gf-h2 mb-0">Checkout — Ambil di Stan</h1>
      <a href="/home/cart" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-left"></i> Keranjang</a>
    </div>
    {% if error %}
      <div class="alert alert-danger">
        {{ error }}
      </div>
    {% endif %}
    {% if (groups|length) == 0 %}
      <div class="text-center py-5">
        <div style="font-size:4rem">
          <i class="bi bi-basket"></i>
        </div>
        <h3>Keranjang masih kosong</h3>
        <p class="text-secondary">
          Pilih menu lalu tekan <strong>Tambah</strong>.
        </p><a href="/" class="btn btn-primary">Lihat menu</a>
      </div>
    {% else %}
      {% for g in groups %}
        <div class="card p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-shop"></i> {{ g.store ? g.store.name : 'Stan' }}</strong>
            <span class="badge bg-secondary">
              Stan {{ g.store and g.store.booth_number ? g.store.booth_number : '—' }}
            </span>
          </div>
          {% for p in g.items %}
            <div class="d-flex gap-2 py-2 border-bottom align-items-center">
              {% if p.image %}
                <img
                  src="{{ p.image|e }}"
                  alt="{{ p.name|e }}"
                  style="width:48px;height:48px;object-fit:cover;border-radius:10px;flex:0 0 auto"
                />
              {% endif %}
              <span class="flex-fill">{{ p.qty }}× {{ p.name }}</span>
              <strong>Rp {{ p.subtotal|number_format(0, ',', '.') }}</strong>
            </div>
          {% endfor %}
          <div class="d-flex justify-content-between pt-2">
            <span class="text-secondary">Subtotal stan</span><strong>Rp {{ g.subtotal|number_format(0, ',', '.') }}</strong>
          </div>
        </div>
      {% endfor %}
      <div class="card p-4">
        <form method="post">
          <input type="hidden" name="step" value="confirm" />
          <input type="hidden" name="store_id" value="{{ scoped|default(0) }}" />
          <label class="form-label">Nama pemesan *</label>
          <input
            class="form-control mb-3"
            name="name"
            maxlength="100"
            required
            value="{{ old.name|e }}"
            placeholder="Nama yang dipanggil di stan"
          />
          <label class="form-label">No. WA (opsional)</label>
          <input
            class="form-control mb-3"
            name="phone"
            value="{{ old.phone|e }}"
            placeholder="081234567890 — untuk dihubungi penjual"
          />
          <label class="form-label">Pembayaran *</label>
          <div class="form-check mb-2">
            <input
              class="form-check-input"
              type="radio"
              name="payment"
              value="QRIS"
              id="payQ"
              {{ old.payment != 'Tunai di stan' ? 'checked' : '' }}
            /><label class="form-check-label" for="payQ">
              <strong>QRIS</strong> — scan QR di stan, penjual verifikasi
            </label>
          </div>
          <div class="form-check mb-3">
            <input
              class="form-check-input"
              type="radio"
              name="payment"
              value="Tunai di stan"
              id="payT"
              {{ old.payment == 'Tunai di stan' ? 'checked' : '' }}
            /><label class="form-check-label" for="payT"><strong>Tunai di stan</strong> — bayar saat ambil</label>
          </div>
          {% for g in groups %}
            {% if g.store and g.store.qris_image %}
              <div class="js-qris-box card p-3 mb-3 text-center" style="background:#fafafa">
                <strong>Scan QRIS {{ g.store.name|e }}</strong>
                <div class="my-2">
                  <img
                    src="{{ g.store.qris_image|e }}"
                    alt="QRIS {{ g.store.name|e }}"
                    style="max-width:260px;width:100%;border-radius:12px"
                  />
                </div>
                <small class="text-secondary">Bayar dulu, lalu buat pesanan. Penjual verifikasi di stan.</small>
              </div>
            {% elseif g.store %}
              <div class="js-qris-box alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                Stan <strong>{{ g.store.name|e }}</strong> belum memasang QRIS — siapkan
                <strong>Tunai</strong> atau scan langsung di stan.
              </div>
            {% endif %}
          {% endfor %}
          <script>
            function syncQris(){var c=document.querySelector('input[name="payment"]:checked'); var
            show=c&&c.value==='QRIS'; document.querySelectorAll('.js-qris-box').forEach(function(b){b.hidden=!show;});}
            document.querySelectorAll('input[name="payment"]').forEach(function(r){r.addEventListener('change',syncQris);});
            document.addEventListener('DOMContentLoaded',syncQris);syncQris();
          </script>
          <label class="form-label">Catatan (opsional)</label>
          <textarea class="form-control mb-3" name="note" placeholder="Contoh: es sedikit, sambal pisah">
            {{ old.note|e }}
          </textarea>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span>Total bayar</span><h2 class="price mb-0">Rp {{ grand|number_format(0, ',', '.') }}</h2>
          </div>
          <button class="btn btn-primary w-100">Buat Pesanan — Ambil di Stan</button>
        </form>
      </div>
    {% endif %}
  </div>
{% endblock %}
