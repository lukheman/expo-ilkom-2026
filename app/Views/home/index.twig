{% extends 'layout.twig' %}
{% block content %}
  {% if habis %}
    <div style="max-width:1200px;margin:16px auto;padding:0 24px">
      <div class="alert alert-warning">
        Menu habis / tidak tersedia. Pilih menu lain.
      </div>
    </div>
  {% endif %}
  {% if db_error %}
    <div style="max-width:1200px;margin:16px auto;padding:0 24px">
      <div class="alert alert-warning">
        {{ db_error }} Jalankan <code>php public/migrate.php</code>, lalu <code>php database/seed.php</code>.
      </div>
    </div>
  {% endif %}

  <section class="gf-banner">
    <div class="gf-banner-inner">
      <div class="gf-banner-text">
        Pesan cepat,<br />ambil di stan<small>Tanpa login • Bayar QRIS / tunai</small>
      </div>
      <img
        class="gf-banner-img"
        src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80&auto=format&fit=crop"
        alt="Makanan hemat"
      />
    </div>
  </section>

  <div class="gf-search-float">
    <form class="gf-search" action="/" method="get">
      <span class="gf-search-icon"><i class="bi bi-search"></i></span>
      <input name="q" value="{{ q }}" placeholder="Ketik makanan atau resto" autocomplete="off" />
      {% if cat %}
        <input type="hidden" name="category" value="{{ cat }}" />
      {% endif %}
      <button class="gf-search-like" type="submit" title="Cari">
        <i class="bi bi-hand-thumbs-up-fill" style="color:#7A1020"></i>
      </button>
    </form>
  </div>

  <div class="gf-container">
    <h2 class="gf-h2">{{ products|length }} menu expo, ambil di stan</h2>

    <div class="gf-filters">
      <a class="gf-pill" href="/" title="Filter"><i class="bi bi-funnel"></i></a>
      <a class="gf-pill {% if filter == 'promo' %}active{% endif %}" href="/?filter=promo">Promo hidangan</a>
      <a class="gf-pill {% if filter == 'termurah' %}active{% endif %}" href="/?filter=termurah">Termurah</a>
      <a class="gf-pill {% if filter == 'hemat20' %}active{% endif %}" href="/?filter=hemat20">Di bawah 20rb</a>
      <a class="gf-pill" href="/seller">Jadi penjual</a>
    </div>

    <div class="gf-cats">
      <a
        class="gf-cat {% if not cat %}active{% endif %}"
        href="/?{{ q ? 'q=' ~ q ~ '&' : '' }}{{ filter ? 'filter=' ~ filter ~ '&' : '' }}"
      >
        <div class="gf-cat-img" style="background:#F7E3D8">
          <i class="bi bi-grid-fill"></i>
        </div>
        <div class="gf-cat-name">
          Semua menu
        </div>
      </a>
      {% for c in categories %}
        <a
          class="gf-cat {% if cat == c.id %}active{% endif %}"
          href="/?category={{ c.id }}{{ q ? '&q=' ~ q : '' }}{{ filter ? '&filter=' ~ filter : '' }}"
        >
          <div class="gf-cat-img">
            <img src="{{ cat_images[c.id] }}" alt="{{ c.name }}" style="width:100%;height:100%;object-fit:cover" />
          </div>
          <div class="gf-cat-name">
            {{ c.name }}
          </div>
        </a>
      {% endfor %}
    </div>

    {% if q or cat or filter %}
      <div style="margin:12px 0;font-size:14px;color:#666">
        Hasil{% if q %}
          untuk "<b>{{ q }}</b>"
        {% endif %}
        {% if cat %} • kategori terpilih{% endif %}
        {% if filter %}
          • filter: {{ filter }}
        {% endif %}• <a href="/">Reset</a>
      </div>
    {% endif %}

    <div class="gf-grid">
      {% for p in products %}
        <div class="gf-card">
          <div class="gf-card-imgwrap">
            <img src="{{ p.image }}" alt="{{ p.name }}" loading="lazy" />
            {% if p.stock <= 0 %}
              <div class="gf-sold">
                <i class="bi bi-x-circle"></i> Habis
              </div>
            {% endif %}
          </div>
          <div class="gf-card-body">
            <h3 class="gf-title">{{ p.name }}</h3>
            <div class="gf-store">
              {{ p.store_name }}{% if p.category_name %} • {{ p.category_name }}{% endif %}
            </div>
            <div class="gf-meta">
              {% if p.stock > 0 %}
                Sisa {{ p.stock }}
              {% else %}
                Stok habis
              {% endif %}
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px">
              <div>
                <span style="font-weight:700">Rp {{ p.price|number_format(0, ',', '.') }}</span>
              </div>
              {% if p.stock > 0 %}
                <button
                  class="gf-add-outline js-open-modal"
                  type="button"
                  data-id="{{ p.id }}"
                  data-name="{{ p.name|e('html_attr') }}"
                  data-desc="{{ p.description|e('html_attr') }}"
                  data-price="{{ p.price }}"
                  data-image="{{ p.image|e('html_attr') }}"
                >
                  Beli
                </button>
              {% else %}
                <button class="gf-add-outline" type="button" disabled>
                  Habis
                </button>
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <p>
          Produk tidak ditemukan. Coba kata kunci lain.
        </p>
      {% endfor %}
    </div>

    <h2 class="gf-h2">Toko pilihan</h2>
    <div class="gf-stores">
      {% for s in stores %}
        <div class="gf-store-card">
          {% if s.photo %}
            <img
              src="{{ s.photo|e }}"
              alt="{{ s.name|e }}"
              style="width:100%;height:140px;object-fit:cover;border-radius:12px"
            />
          {% else %}
            <div style="font-size:28px">
              <i class="bi bi-shop"></i>
            </div>
          {% endif %}
          <h5 style="margin:8px 0">{{ s.name }}</h5>
          <p style="color:#666;font-size:14px;margin:0">
            {{ s.description }}
          </p>
          <div style="font-size:13px;color:#666;margin-top:8px">
            Stan {{ s.booth_number|default('—') }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <style>
    .gf-add-outline{border:1px solid #7C9A2E;color:#556B1E;background:#fff;border-radius:9999px;padding:8px
    24px;font-weight:600;font-size:14px;min-height:44px;cursor:pointer} .gf-add-outline:hover{background:#EBF1DA}
    .gf-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px}
    .gf-overlay[hidden]{display:none}
    .gf-modal{background:#fff;border-radius:16px;width:100%;max-width:480px;max-height:92vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:rgba(0,0,0,.12)
    0 2px 8px 0} .gf-modal-scroll{overflow-y:auto;padding:24px 24px 0} .gf-modal
    h3{font-size:20px;font-weight:700;margin:0 0 4px} .gf-modal-desc{font-size:14px;color:#666;margin:0 0 12px}
    .gf-modal-price{font-size:16px;font-weight:700} .gf-modal-price
    s{color:#999;font-weight:400;margin-left:8px;font-size:14px}
    .gf-sec-title{font-size:18px;font-weight:700;margin:20px 0 0} .gf-opt-group{border-top:1px solid
    #f0f0f0;margin-top:16px;padding-top:16px}
    .gf-opt-head{font-size:16px;font-weight:700;display:flex;justify-content:space-between;align-items:center}
    .gf-opt-head span{color:#7C9A2E} .gf-req{font-size:14px;color:#666;margin:4px 0 8px} .gf-req
    b{color:#7C9A2E;font-weight:600} .gf-opt{display:flex;justify-content:space-between;align-items:center;padding:12px
    0;border-bottom:1px solid #f6f6f6;font-size:15px;cursor:pointer} .gf-opt
    input{width:22px;height:22px;accent-color:#7C9A2E} .gf-foot{position:sticky;bottom:0;background:#fff;padding:16px 0
    20px;border-top:1px solid #f0f0f0;margin-top:16px}
    .gf-qtyrow{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:15px}
    .gf-stepper{display:flex;align-items:center;gap:12px} .gf-step{width:36px;height:36px;border-radius:50%;border:1px
    solid
    #7C9A2E;background:#fff;color:#7C9A2E;font-size:20px;line-height:1;cursor:pointer;min-width:44px;min-height:44px}
    .gf-step:disabled{opacity:.35}
    .gf-submit{width:100%;background:#7C9A2E;color:#fff;border:0;border-radius:9999px;padding:14px
    24px;font-size:16px;font-weight:700;min-height:52px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .gf-submit strong{font-size:18px}
    .gf-close{position:absolute;top:12px;right:16px;border:0;background:#f0f0f0;width:36px;height:36px;border-radius:50%;cursor:pointer}
  </style>

  <div class="gf-overlay" id="gfOverlay" hidden>
    <div class="gf-modal" role="dialog" aria-modal="true">
      <div style="position:relative">
        <button class="gf-close" id="gfClose" type="button"><i class="bi bi-x-lg"></i></button>
        <div class="gf-modal-scroll">
          <h3 id="mName"></h3>
          <p class="gf-modal-desc" id="mDesc"></p>
          <div class="gf-modal-price">
            <span id="mPrice"></span>
          </div>
          <div class="gf-sec-title">
            Sesuaikan pesanan
          </div>
          <form method="post" action="/home/checkout" id="mForm">
            <input type="hidden" name="product_id" id="mId" />
            <input type="hidden" name="qty" id="mQtyInput" value="1" />
            <div class="gf-foot">
              <div class="gf-qtyrow">
                <span>Berapa banyak?</span>
                <span class="gf-stepper">
                  <button class="gf-step" id="qMinus" type="button">−</button><b id="qVal">1</b><button
                    class="gf-step"
                    id="qPlus"
                    type="button"
                  >
                    +
                  </button>
                </span>
              </div>
              <button class="gf-submit" id="mSubmit" type="submit">
                <span>Beli Sekarang</span><strong id="mTotal"></strong>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
    var overlay=document.getElementById('gfOverlay');
    var mName=document.getElementById('mName');
    var mDesc=document.getElementById('mDesc');
    var mPrice=document.getElementById('mPrice');
    var mId=document.getElementById('mId');
    var qVal=document.getElementById('qVal');
    var qIn=document.getElementById('mQtyInput');
    var mTotal=document.getElementById('mTotal');
    var base=0, qty=1;
    function rp(n){return 'Rp '+Number(n).toLocaleString('id-ID');}
    function total(){return base*qty;}
    function refresh(){
    mPrice.textContent=rp(base);mTotal.textContent=rp(total());
    qVal.textContent=qty;qIn.value=qty;
    document.getElementById('qMinus').disabled=qty<=1;
    document.getElementById('qPlus').disabled=qty>=10;}
    document.querySelectorAll('.js-open-modal').forEach(function(b){b.addEventListener('click',function(){
    base=parseInt(b.dataset.price,10)||0;mId.value=b.dataset.id;mName.textContent=b.dataset.name;
    mDesc.textContent=b.dataset.desc||'Dibuat segar dengan bahan pilihan.';
    qty=1;
    refresh();overlay.hidden=false;document.body.style.overflow='hidden'; });});
    document.getElementById('qMinus').addEventListener('click',function(){if(qty>1){qty--;refresh();}});
    document.getElementById('qMinus').addEventListener('click',function(){if(qty>1){qty--;refresh();}});
    document.getElementById('qPlus').addEventListener('click',function(){if(qty<10){qty++;refresh();}});
    document.getElementById('gfClose').addEventListener('click',function(){overlay.hidden=true;document.body.style.overflow='';});
    overlay.addEventListener('click',function(e){if(e.target===overlay){overlay.hidden=true;document.body.style.overflow='';}});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){overlay.hidden=true;document.body.style.overflow='';}});
    })();
  </script>
{% endblock %}
