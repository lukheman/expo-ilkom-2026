{% extends 'layout.twig' %}
{% block content %}
  {% if habis %}
    <div style="max-width:1200px;margin:16px auto;padding:0 24px">
      <div class="alert alert-warning">
        Menu habis / tidak tersedia. Pilih menu lain.
      </div>
    </div>
  {% endif %}
  {% if db_error %}
    <div style="max-width:1200px;margin:16px auto;padding:0 24px">
      <div class="alert alert-warning">
        {{ db_error }} Jalankan <code>php public/migrate.php</code>, lalu <code>php database/seed.php</code>.
      </div>
    </div>
  {% endif %}

  <section class="gf-banner">
    <div class="gf-banner-inner">
      <div class="gf-banner-text">
        Pesan cepat,<br />ambil di stan<small>Bayar QRIS / tunai</small>
      </div>
      <img
        class="gf-banner-img"
        src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80&auto=format&fit=crop"
        alt="Makanan hemat"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <div class="gf-search-float">
    <form class="gf-search" action="/" method="get">
      <span class="gf-search-icon"><i class="bi bi-search"></i></span>
      <input name="q" value="{{ q }}" placeholder="Ketik makanan atau resto" autocomplete="off" enterkeyhint="search" />
      {% if cat %}
        <input type="hidden" name="category" value="{{ cat }}" />
      {% endif %}
      <button class="gf-search-like" type="submit" title="Cari">
        <i class="bi bi-hand-thumbs-up-fill" style="color:#7A1020"></i>
      </button>
    </form>
  </div>

  <div class="gf-container">
    <h2 class="gf-h2">{{ products|length }} menu expo, ambil di stan</h2>

    <div class="gf-cats">
      <a class="gf-cat {% if not cat %}active{% endif %}" href="/?{{ q ? 'q=' ~ q : '' }}">
        <div class="gf-cat-img" style="background:#F7E3D8">
          <i class="bi bi-grid-fill"></i>
        </div>
        <div class="gf-cat-name">
          Semua menu
        </div>
      </a>
      {% for c in categories %}
        <a class="gf-cat {% if cat == c.id %}active{% endif %}" href="/?category={{ c.id }}{{ q ? '&q=' ~ q : '' }}">
          <div class="gf-cat-img">
            <img
              src="{{ cat_images[c.id] }}"
              alt="{{ c.name }}"
              style="width:100%;height:100%;object-fit:cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="gf-cat-name">
            {{ c.name }}
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="gf-grid">
      {% for p in products %}
        <div class="gf-card">
          <div class="gf-card-imgwrap">
            <img src="{{ p.image }}" alt="{{ p.name }}" loading="lazy" decoding="async" />
            {% if p.stock <= 0 %}
              <div class="gf-sold">
                <i class="bi bi-x-circle"></i> Habis
              </div>
            {% endif %}
          </div>
          <div class="gf-card-body">
            <h3 class="gf-title">{{ p.name }}</h3>
            <div class="gf-store">
              {{ p.store_name }}{% if p.category_name %}
                • {{ p.category_name }}
              {% endif %}
            </div>
            <div class="gf-meta">
              {% if p.stock > 0 %}
                Sisa {{ p.stock }}
              {% else %}
                Stok habis
              {% endif %}
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px">
              <div>
                <span style="font-weight:700">Rp {{ p.price|number_format(0, ',', '.') }}</span>
              </div>
              {% if p.stock > 0 %}
                <a class="gf-add-outline text-decoration-none" href="/home/store/{{ p.store_id }}">Beli</a>
              {% else %}
                <button class="gf-add-outline" type="button" disabled>Habis</button>
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <p>
          Produk tidak ditemukan. Coba kata kunci lain.
        </p>
      {% endfor %}
    </div>

    <h2 class="gf-h2">Toko pilihan</h2>
    <div class="gf-stores">
      {% for s in stores %}
        <a href="/home/store/{{ s.id }}" class="gf-store-card text-decoration-none">
          {% if s.photo %}
            <img
              src="{{ s.photo|e }}"
              alt="{{ s.name|e }}"
              style="width:100%;height:140px;object-fit:cover;border-radius:12px"
              loading="lazy"
              decoding="async"
            />
          {% else %}
            <div style="font-size:28px">
              <i class="bi bi-shop"></i>
            </div>
          {% endif %}
          <h5 style="margin:8px 0">{{ s.name }}</h5>
          <p style="color:#666;font-size:14px;margin:0">
            {{ s.description }}
          </p>
          <div style="font-size:13px;color:#666;margin-top:8px">
            Stan {{ s.booth_number|default('—') }} • Lihat menu <i class="bi bi-arrow-right"></i>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endblock %}
