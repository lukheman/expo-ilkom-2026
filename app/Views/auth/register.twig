{% extends "layout.twig" %}{% block content %}<div class="row justify-content-center"><div class="col-md-5"><div class="card p-4"><h2 class="fw-bold">Buat akun baru</h2><form method="post"><input class="form-control mb-3" name="name" placeholder="Nama lengkap" required><input class="form-control mb-3" type="email" name="email" placeholder="Email" required><input class="form-control mb-3" type="password" name="password" placeholder="Password" required><select class="form-select mb-4" name="role"><option value="buyer">Saya ingin belanja</option><option value="seller">Saya ingin berjualan</option></select><button class="btn btn-primary w-100">Daftar sekarang</button></form></div></div></div>{% endblock %}
