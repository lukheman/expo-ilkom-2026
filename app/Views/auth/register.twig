{% extends "layout.twig" %}{% block content %}<div class="row justify-content-center"><div class="col-md-5"><div class="card p-4"><h2 class="fw-bold">Daftar sebagai Penjual</h2><p class="text-secondary">Akun hanya untuk penjual stan expo. <strong>Pembeli tidak perlu daftar</strong> — langsung pesan dan ambil di stan.</p><form method="post"><input class="form-control mb-3" name="name" placeholder="Nama lengkap" required><input class="form-control mb-3" type="email" name="email" placeholder="Email" required><input class="form-control mb-3" type="password" name="password" placeholder="Password" required><input type="hidden" name="role" value="seller"><button class="btn btn-primary w-100">Daftar sebagai penjual</button></form><p class="mt-3 mb-0">Sudah punya akun? <a href="/auth/login">Masuk</a></p></div></div></div>{% endblock %}
