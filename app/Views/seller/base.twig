{% extends 'layout.twig' %}
{% block content %}
  <style>
    .seller-side{position:fixed;left:0;top:0;bottom:0;width:260px;background:#fff;border-right:1px solid
    #f0f0f0;z-index:120;padding:16px 12px;overflow-y:auto;box-shadow:var(--sh-pop);transition:transform .25s ease}
    .seller-side h4{font-size:11px;font-weight:700;color:#999;text-transform:uppercase;letter-spacing:1.5px;margin:4px 12px 8px} .seller-side
    .nav-link{display:flex;align-items:center;gap:10px;color:#000;font-weight:600;font-size:14px;border-radius:12px;padding:12px;min-height:44px}
    .seller-side .nav-link:hover{background:#fafafa} .seller-side .nav-pills
    .nav-link.active{background:#E2543A;color:#fff} .seller-side .nav-link.logout{color:#C0262D} .seller-side
    .nav-link.logout:hover{background:#F9E2E3;color:#8E1B22}
    .seller-badge{margin-left:auto;background:#C0262D;color:#fff;font-size:11px;font-weight:700;border-radius:9999px;padding:2px
    8px}
    .side-logo{display:block;text-align:center;padding:8px 0 12px}
    .side-logo img{height:48px;width:auto}
    .seller-main{margin-left:260px;padding:24px 32px 64px;min-height:80vh;transition:margin-left .25s ease}
    body.panel-closed .seller-side{transform:translateX(-110%)}
    body.panel-closed .seller-main,body.panel-closed .gf-footer{margin-left:0} .seller-main .gf-h2{margin-top:0}
    .seller-main .card{border-radius:16px;border:1px solid #f0f0f0} .seller-main .table{--bs-table-hover-bg:#FCEFD9}
    .seller-main .table thead
    th{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#666;background:#FFF9EF;border-bottom:2px solid
    #E2543A;white-space:nowrap} .gf-footer{margin-left:260px} .seller-menu-btn{display:none} .seller-scrim{display:none}
    @media(max-width:860px){ .seller-main{margin-left:0;padding:16px 16px 48px} .gf-footer{margin-left:0}
    .seller-side{transform:translateX(-110%);transition:transform .25s ease;width:270px} body.panel-open
    .seller-side{transform:none} body.panel-open
    .seller-scrim{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:110}
    .seller-menu-btn{display:inline-flex} }
  </style>
  <aside class="seller-side">
    <a class="side-logo" href="/"><img src="/logo/logo-ladusing.png" alt="Logo Ladusing" /></a>
    <h4>Menu Stan</h4>
    <nav class="nav nav-pills flex-column">
      <a class="nav-link {% if menu == 'dashboard' %}active{% endif %}" href="/seller">
        <i class="bi bi-house"></i> Dashboard
      </a>
      <a class="nav-link {% if menu == 'orders' %}active{% endif %}" href="/seller/orders">
        <i class="bi bi-receipt"></i> Pesanan{% if activeOrders %}
          <span class="seller-badge">{{ activeOrders }}</span>
        {% endif %}
      </a>
      <a class="nav-link {% if menu == 'products' %}active{% endif %}" href="/seller/products">
        <i class="bi bi-basket"></i> Produk
      </a>
      <a class="nav-link {% if menu == 'store' %}active{% endif %}" href="/seller/store">
        <i class="bi bi-gear"></i> Profil Toko
      </a>
    </nav>
    <div style="border-top:1px solid #f0f0f0;margin:8px 0"></div>
    <nav class="nav nav-pills flex-column">
      <a class="nav-link" href="/"><i class="bi bi-globe"></i> Lihat katalog</a>
      <a class="nav-link logout" href="/logout"><i class="bi bi-box-arrow-right"></i> Keluar</a>
    </nav>
  </aside>
  <div class="seller-scrim" id="panelScrim"></div>
  <main class="seller-main">
    {% block seller_content %}

    {% endblock %}
  </main>
{% endblock %}
