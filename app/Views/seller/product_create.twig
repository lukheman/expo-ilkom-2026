{% extends 'seller/base.twig' %}
{% block seller_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/seller">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/seller/products">Produk</a></li>
      <li class="breadcrumb-item active" aria-current="page">Tambah</li>
    </ol>
  </nav>
  <h1 class="gf-h2">Tambah Produk</h1>
  {% if uploadMsg %}
    <div class="alert alert-danger">{{ uploadMsg }}</div>
  {% endif %}
  <div class="card p-4">
    <form method="post" action="/seller/save" enctype="multipart/form-data" class="row g-2">
      <input type="hidden" name="store" value="{{ store ? store.name : '' }}" />
      <div class="col-12">
        <label class="form-label">Nama produk *</label><input
          class="form-control"
          name="name"
          maxlength="100"
          required
        />
      </div>
      <div class="col-12">
        <label class="form-label">Kategori</label><select class="form-select" name="category">
          <option value="">
            — Tanpa kategori —
          </option>
          {% for c in categories %}
            <option value="{{ c.id }}">
              {{ c.name }}
            </option>
          {% endfor %}
        </select>
      </div>
      <div class="col-12">
        <label class="form-label">Deskripsi</label><input
          class="form-control"
          name="description"
          maxlength="500"
        />
      </div>
      <div class="col-6">
        <label class="form-label">Harga (Rp) *</label><input
          class="form-control"
          name="price"
          type="number"
          min="0"
          required
        />
      </div>
      <div class="col-6">
        <label class="form-label">Stok *</label><input
          class="form-control"
          name="stock"
          type="number"
          min="0"
          required
        />
      </div>
      <div class="col-12">
        <label class="form-label">
          Foto produk <small class="text-secondary">(JPG/PNG/WebP, maks 2MB)</small>
        </label><input
          class="form-control"
          type="file"
          name="photo"
          accept="image/jpeg,image/png,image/webp,image/gif"
        /><input class="form-control mt-2" name="image" placeholder="atau tempel URL foto" maxlength="255" />
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Simpan produk</button><a class="btn btn-secondary" href="/seller/products">Batal</a>
      </div>
    </form>
  </div>
{% endblock %}
