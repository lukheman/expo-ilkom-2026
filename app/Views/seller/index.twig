{% extends "layout.twig" %}{% block content %}<div class="d-flex justify-content-between"><div><h1 class="fw-bold">Dashboard Penjual</h1><p class="text-secondary">Kelola menu dan toko kamu.</p></div><a href="/auth/logout" class="btn btn-outline-secondary">Keluar</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-4"><small>Total penjualan</small><h2 class="price">Rp 0</h2></div></div><div class="col-md-4"><div class="card p-4"><small>Pesanan</small><h2>0</h2></div></div><div class="col-md-4"><div class="card p-4"><small>Produk aktif</small><h2>{{ products|length }}</h2></div></div></div><div class="card p-4"><h4>Tambah produk</h4><form method="post" action="/seller/save" class="row g-2"><input class="form-control" name="store" placeholder="Nama toko" required><input class="form-control" name="name" placeholder="Nama produk" required><input class="form-control" name="description" placeholder="Deskripsi"><input class="form-control" name="price" type="number" placeholder="Harga" required><input class="form-control" name="stock" type="number" placeholder="Stok" required><input class="form-control" name="image" placeholder="URL foto"><select class="form-select" name="category">{% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select><button class="btn btn-primary">Simpan produk</button></form></div><h4 class="mt-4">Produk kamu</h4><div class="list-group">{% for p in products %}<div class="list-group-item d-flex justify-content-between"><span>{{ p.name }} · Rp {{ p.price|number_format(0,',','.') }}</span><a class="text-danger" href="/seller/delete/{{ p.id }}">Hapus</a></div>{% endfor %}</div>{% endblock %}
