{% extends 'layout.twig' %}
{% block content %}
  <div class="gf-container" style="max-width:640px;text-align:center;padding-top:48px">
    <div style="font-size:4rem">
      <i class="bi bi-hourglass-split"></i>
    </div>
    <h1 class="gf-h2">Akun penjual {{ status == 'rejected' ? 'ditolak' : 'menunggu persetujuan admin' }}</h1>
    {% if status == 'rejected' %}
      <p class="text-secondary">
        Pendaftaran stan Anda ditolak panitia. Hubungi panitia expo untuk informasi lebih lanjut.
      </p>
    {% else %}
      <p class="text-secondary">
        Pendaftaran Anda sedang diperiksa panitia. Dashboard terbuka setelah admin menyetujui.
      </p>
    {% endif %}
    <a href="/auth/logout" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Keluar</a>
  </div>
{% endblock %}
