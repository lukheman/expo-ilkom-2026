{% extends 'seller/base.twig' %}
{% block seller_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/seller">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">Produk</li>
    </ol>
  </nav>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="gf-h2 mb-0"><i class="bi bi-basket"></i> Kelola Produk</h1>
    <a class="btn btn-primary" href="/seller/create"><i class="bi bi-plus-lg"></i> Tambah</a>
  </div>
  <div class="card p-3 datatable-card">
    <table class="table table-hover align-middle mb-0 datatable w-100">
      <thead>
        <tr>
          <th>Produk</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Status</th>
          <th class="no-sort">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {% for p in products %}
          <tr>
            <td>{{ p.name|e }}</td>
            <td>Rp {{ p.price|number_format(0, ',', '.') }}</td>
            <td>
              {% if p.stock <= 5 %}
                <span class="badge bg-danger">{{ p.stock }}</span>
              {% else %}
                {{ p.stock }}
              {% endif %}
            </td>
            <td>
              <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                <input
                  class="form-check-input js-status-toggle mt-0"
                  type="checkbox"
                  role="switch"
                  data-url="/seller/toggle/{{ p.id }}?format=json"
                  data-fallback="/seller/toggle/{{ p.id }}"
                  data-label="statusLabel{{ p.id }}"
                  {{ p.active ? 'checked' : '' }}
                />
                <label class="form-label mb-0 small" id="statusLabel{{ p.id }}">
                  {{ p.active ? 'Aktif' : 'Nonaktif' }}
                </label>
              </div>
            </td>
            <td>
              <div class="table-actions">
                <a class="btn btn-sm btn-warning" href="/seller/edit/{{ p.id }}"><i class="bi bi-pencil"></i> Ubah</a><a
                  class="btn btn-sm btn-danger"
                  href="/seller/delete/{{ p.id }}"
                  onclick="return confirm('Hapus produk ini?')"
                >
                  <i class="bi bi-trash"></i> Hapus
                </a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="text-secondary">Belum ada produk.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <script>
    document.querySelectorAll('.js-status-toggle').forEach(function(sw){
    sw.addEventListener('change',function(){
    var want=sw.checked, label=document.getElementById(sw.dataset.label);
    if(typeof fetch==='undefined'){if(sw.dataset.fallback){window.location=sw.dataset.fallback;}else{sw.checked=!want;}return;}
    sw.disabled=true;
    fetch(sw.dataset.url).then(function(r){return r.json();}).then(function(d){
    if(d&&d.ok){if(label){label.textContent=d.label;}}
    else{sw.checked=!want;}
    }).catch(function(){sw.checked=!want;}).finally(function(){sw.disabled=false;});
    });
    });
  </script>
{% endblock %}
