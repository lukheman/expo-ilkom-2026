{% extends 'seller/base.twig' %}
{% block seller_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/seller">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">Produk</li>
    </ol>
  </nav>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="gf-h2 mb-0"><i class="bi bi-basket"></i> Kelola Produk</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#tambahModal">
      <i class="bi bi-plus-lg"></i> Tambah
    </button>
  </div>
  {% if uploadMsg %}
    <div class="alert alert-danger">
      {{ uploadMsg }}
    </div>
  {% endif %}
  <div class="card p-3 datatable-card">
    <table class="table table-hover align-middle mb-0 datatable w-100">
      <thead>
        <tr>
          <th>Produk</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Status</th>
          <th class="no-sort">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {% for p in products %}
          <tr>
            <td>{{ p.name|e }}</td>
            <td>Rp {{ p.price|number_format(0, ',', '.') }}</td>
            <td>
              {% if p.stock <= 5 %}
                <span class="badge bg-danger">{{ p.stock }}</span>
              {% else %}
                {{ p.stock }}
              {% endif %}
            </td>
            <td>
              {% if p.active %}
                <span class="badge bg-success">Aktif</span>
              {% else %}
                <span class="badge bg-secondary">Nonaktif</span>
              {% endif %}
            </td>
            <td>
              <div class="table-actions">
                <a class="btn btn-sm btn-primary" href="/seller/edit/{{ p.id }}"><i class="bi bi-pencil"></i> Ubah</a><a
                  class="btn btn-sm btn-outline-secondary"
                  href="/seller/toggle/{{ p.id }}"
                >
                  <i class="bi bi-power"></i> Aktif/Nonaktif
                </a><a
                  class="btn btn-sm btn-outline-danger"
                  href="/seller/delete/{{ p.id }}"
                  onclick="return confirm('Hapus produk ini?')"
                >
                  <i class="bi bi-trash"></i> Hapus
                </a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="text-secondary">Belum ada produk.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Modal Tambah Produk #}
  <div class="modal fade" id="tambahModal" tabindex="-1" aria-labelledby="tambahModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tambahModalLabel">Tambah Produk</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form method="post" action="/seller/save" enctype="multipart/form-data" class="row g-2 p-3">
          <input type="hidden" name="store" value="{{ store ? store.name : '' }}" />
          <div class="col-md-6">
            <label class="form-label">Nama produk *</label>
            <input class="form-control" name="name" placeholder="Nama produk *" maxlength="100" required />
          </div>
          <div class="col-md-6">
            <label class="form-label">Kategori</label>
            <select class="form-select" name="category">
              <option value="">
                — Kategori —
              </option>
              {% for c in categories %}
                <option value="{{ c.id }}">
                  {{ c.name }}
                </option>
              {% endfor %}
            </select>
          </div>
          <div class="col-12">
            <label class="form-label">Deskripsi</label>
            <input class="form-control" name="description" placeholder="Deskripsi" maxlength="500" />
          </div>
          <div class="col-6">
            <label class="form-label">Harga (Rp) *</label>
            <input class="form-control" name="price" type="number" min="0" placeholder="Harga (Rp) *" required />
          </div>
          <div class="col-6">
            <label class="form-label">Stok *</label>
            <input class="form-control" name="stock" type="number" min="0" placeholder="Stok *" required />
          </div>
          <div class="col-12">
            <label class="form-label mb-0">
              Foto produk <small class="text-secondary">(JPG/PNG/WebP, maks 2MB)</small>
            </label>
            <input
              class="form-control mt-1"
              type="file"
              name="photo"
              accept="image/jpeg,image/png,image/webp,image/gif"
            />
            <input class="form-control mt-2" name="image" placeholder="atau tempel URL foto" maxlength="255" />
          </div>
          <div class="col-12 d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
            <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Simpan produk</button>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
