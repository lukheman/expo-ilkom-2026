{% extends 'seller/base.twig' %}
{% block seller_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/seller">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">Profil Toko</li>
    </ol>
  </nav>
  <h1 class="gf-h2"><i class="bi bi-gear"></i> Profil Toko</h1>
  {% if uploadMsg %}
    <div class="alert alert-danger">{{ uploadMsg }}</div>
  {% endif %}
  <div class="card p-4">
    <form method="post" action="/seller/updateStore" enctype="multipart/form-data" class="row g-2">
      <div class="col-md-8">
        <label class="form-label">Nama toko *</label><input
          class="form-control"
          name="name"
          value="{{ store ? store.name|e : '' }}"
          maxlength="100"
          required
        />
      </div>
      <div class="col-md-4">
        <label class="form-label">Nomor stan</label><input
          class="form-control"
          name="booth"
          value="{{ store and store.booth_number ? store.booth_number|e : '' }}"
          maxlength="10"
          placeholder="A4"
        />
      </div>
      <div class="col-12">
        <label class="form-label">Deskripsi</label><textarea class="form-control" name="description" maxlength="500">
          {{ store ? store.description|e : '' }}
        </textarea>
      </div>
      <div class="col-12">
        <label class="form-label">Foto profil toko <small class="text-secondary">(JPG/PNG/WebP, maks 2MB)</small></label>
        {% if store and store.photo %}
          <div class="mb-2">
            <img
              src="{{ store.photo|e }}"
              alt="Foto {{ store.name|e }}"
              style="max-width:220px;border:1px solid #eee;border-radius:12px"
            />
          </div>
        {% endif %}
        <input
          class="form-control"
          type="file"
          name="photo"
          accept="image/jpeg,image/png,image/webp,image/gif"
        />
        <div class="form-text">Upload baru untuk mengganti. Kosongkan jika tidak diganti.</div>
      </div>
      <div class="col-12">
        <label class="form-label">QRIS pembayaran <small class="text-secondary">(JPG/PNG/WebP, maks 2MB)</small></label>
        {% if store and store.qris_image %}
          <div class="mb-2">
            <img
              src="{{ store.qris_image|e }}"
              alt="QRIS {{ store.name|e }}"
              style="max-width:220px;border:1px solid #eee;border-radius:12px"
            />
          </div>
        {% endif %}
        <input
          class="form-control"
          type="file"
          name="qris"
          accept="image/jpeg,image/png,image/webp,image/gif"
        />
        <div class="form-text">Upload baru untuk mengganti. Kosongkan jika tidak diganti.</div>
      </div>
      <div class="col-12">
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Simpan profil</button>
      </div>
    </form>
  </div>
{% endblock %}
