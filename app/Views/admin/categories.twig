{% extends 'admin/base.twig' %}
{% block admin_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
      <li class="breadcrumb-item active" aria-current="page">Kategori</li>
    </ol>
  </nav>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="gf-h2 mb-0">Kelola Kategori</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#tambahModal">
      <i class="bi bi-plus-lg"></i> Tambah
    </button>
  </div>
  <div class="card p-3 datatable-card">
    <table class="table table-hover align-middle mb-0 datatable w-100">
      <thead>
        <tr>
          <th>Foto</th>
          <th>Nama</th>
          <th>Slug</th>
          <th class="no-sort">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {% for c in categories %}
          <tr>
            <td>
              {% if c.image %}
                <img
                  src="{{ c.image|e }}"
                  alt="{{ c.name|e }}"
                  style="width:48px;height:48px;object-fit:cover;border-radius:12px"
                />
              {% else %}
                <span class="text-secondary">—</span>
              {% endif %}
            </td>
            <td>{{ c.name|e }}</td>
            <td><small class="text-secondary">{{ c.slug }}</small></td>
            <td>
              <div class="table-actions">
                <button
                  type="button"
                  class="btn btn-sm btn-warning"
                  data-bs-toggle="modal"
                  data-bs-target="#editModal{{ c.id }}"
                >
                  <i class="bi bi-pencil"></i> Ubah
                </button><a
                  class="btn btn-sm btn-danger"
                  href="/admin/delCategory/{{ c.id }}"
                  onclick="return confirm('Hapus kategori {{ c.name|e('js') }}?')"
                >
                  <i class="bi bi-trash"></i> Hapus
                </a>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="text-secondary mt-3" style="font-size:13px">
    Kategori yang masih dipakai produk tidak bisa dihapus.
  </p>

  {# Modal Tambah Kategori #}
  <div class="modal fade" id="tambahModal" tabindex="-1" aria-labelledby="tambahModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tambahModalLabel">Tambah Kategori</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form method="post">
          <div class="modal-body row g-2">
            <div class="col-12">
              <label class="form-label">Nama kategori *</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-tags"></i></span>
                <input class="form-control" name="name" maxlength="50" placeholder="Nama kategori baru" required />
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">URL foto</label>
              <input
                class="form-control"
                name="image"
                maxlength="255"
                placeholder="https://… atau /uploads/… (opsional)"
              />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
            <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tambah</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {# Modal Ubah per kategori #}
  {% for c in categories %}
    <div
      class="modal fade"
      id="editModal{{ c.id }}"
      tabindex="-1"
      aria-labelledby="editModalLabel{{ c.id }}"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editModalLabel{{ c.id }}">Ubah Kategori #{{ c.id }}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form method="post" action="/admin/updateCategory/{{ c.id }}">
            <div class="modal-body row g-2">
              <div class="col-12">
                <label class="form-label">Nama kategori *</label>
                <input class="form-control" name="name" maxlength="50" value="{{ c.name|e }}" required />
              </div>
              <div class="col-12">
                <label class="form-label">URL foto</label>
                <input
                  class="form-control"
                  name="image"
                  maxlength="255"
                  value="{{ c.image|default('')|e }}"
                  placeholder="https://… atau /uploads/… (kosongkan untuk hapus)"
                />
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
              <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Simpan</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  {% endfor %}
{% endblock %}
