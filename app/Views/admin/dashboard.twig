{% extends 'admin/base.twig' %}
{% block admin_content %}
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
    </ol>
  </nav>
  <h1 class="gf-h2"><i class="bi bi-shield-check"></i> Admin Expo</h1>
  <div class="row g-3">
    <div class="col-6 col-md-4">
      <div class="card stat-card p-3 h-100">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-secondary">Penjual</small><h2 class="mb-0">{{ sellers }}</h2>
          </div><span class="stat-icon"><i class="bi bi-shop"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card stat-card blue p-3 h-100">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-secondary">Stan / toko</small><h2 class="mb-0">{{ stores }}</h2>
          </div><span class="stat-icon"><i class="bi bi-geo-alt"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card stat-card green p-3 h-100">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-secondary">Produk</small><h2 class="mb-0">{{ products }}</h2>
          </div><span class="stat-icon"><i class="bi bi-basket"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card stat-card p-3 h-100">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-secondary">Pesanan</small><h2 class="mb-0">{{ orders }}</h2>
          </div><span class="stat-icon"><i class="bi bi-receipt"></i></span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-4">
      <div class="card stat-card green p-3 h-100">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <small class="text-secondary">Omzet (non-batal)</small><h2 class="price mb-0">
              Rp {{ revenue|number_format(0, ',', '.') }}
            </h2>
          </div><span class="stat-icon"><i class="bi bi-cash-stack"></i></span>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
