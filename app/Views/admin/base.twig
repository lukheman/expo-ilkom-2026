{% extends 'layout.twig' %}
{% block content %}
  <style>
    /* Sidebar fixed menempel di kiri layar */
    .admin-side{position:fixed;left:0;top:0;bottom:0;width:260px;background:#fff;border-right:1px solid
    #f0f0f0;z-index:120;padding:16px 12px;overflow-y:auto;box-shadow:var(--sh-pop);transition:transform .25s ease}
    .admin-side h4{font-size:11px;font-weight:700;color:#999;text-transform:uppercase;letter-spacing:1.5px;margin:4px 12px 8px} /* Bootstrap nav-pills + sentuhan tema expo */ .admin-side
    .nav-link{display:flex;align-items:center;gap:10px;color:#000;font-weight:600;font-size:14px;border-radius:12px;padding:12px;min-height:44px}
    .admin-side .nav-link:hover{background:#fafafa} .admin-side .nav-pills
    .nav-link.active{background:#E2543A;color:#fff} .admin-side .nav-link.logout{color:#C0262D} .admin-side
    .nav-link.logout:hover{background:#F9E2E3;color:#8E1B22}
    .admin-badge{margin-left:auto;background:#C0262D;color:#fff;font-size:11px;font-weight:700;border-radius:9999px;padding:2px
    8px}
    .side-logo{display:block;text-align:center;padding:8px 0 12px}
    .side-logo img{width:140px;height:auto}
    .admin-main{margin-left:260px;padding:24px 32px 64px;min-height:80vh;transition:margin-left .25s ease}
    body.panel-closed .admin-side{transform:translateX(-110%)}
    body.panel-closed .admin-main,body.panel-closed .gf-footer{margin-left:0} .admin-main .gf-h2{margin-top:0} /* Tema
    kustom di atas Bootstrap */ .admin-main .card{border-radius:16px;border:1px solid #f0f0f0} .admin-main
    .table{--bs-table-hover-bg:#FCEFD9} .admin-main .table thead
    th{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#666;background:#FFF9EF;border-bottom:2px solid
    #E2543A;white-space:nowrap} .stat-card{border-top:4px solid #E2543A} .stat-card.green{border-top-color:#7C9A2E}
    .stat-card.red{border-top-color:#C0262D} .stat-card.blue{border-top-color:#2B4570} .stat-icon{font-size:28px}
    .gf-footer{margin-left:260px} .admin-menu-btn{display:none} .admin-scrim{display:none} @media(max-width:860px){
    .admin-main{margin-left:0;padding:16px 16px 48px} .gf-footer{margin-left:0}
    .admin-side{transform:translateX(-110%);transition:transform .25s ease;width:270px} body.panel-open
    .admin-side{transform:none} body.panel-open
    .admin-scrim{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:110}
    .admin-menu-btn{display:inline-flex} }
  </style>
  <aside class="admin-side">
    <a class="side-logo" href="/"><img src="/logo/logo-ladusing.png" alt="Logo Ladusing" /></a>
    <h4>Menu Admin</h4>
    <nav class="nav nav-pills flex-column">
      <a class="nav-link {% if menu == 'dashboard' %}active{% endif %}" href="/admin">
        <i class="bi bi-house"></i> Dashboard
      </a>
      <a class="nav-link {% if menu == 'sellers' %}active{% endif %}" href="/admin/sellers">
        <i class="bi bi-shop"></i> Penjual{% if pending %}
          <span class="admin-badge">{{ pending }}</span>
        {% endif %}
      </a>
      <a class="nav-link {% if menu == 'users' %}active{% endif %}" href="/admin/users">
        <i class="bi bi-people"></i> Pengguna
      </a>
      <a class="nav-link {% if menu == 'categories' %}active{% endif %}" href="/admin/categories">
        <i class="bi bi-tags"></i> Kategori
      </a>
      <a class="nav-link {% if menu == 'products' %}active{% endif %}" href="/admin/products">
        <i class="bi bi-basket"></i> Produk
      </a>
      <a class="nav-link {% if menu == 'orders' %}active{% endif %}" href="/admin/orders">
        <i class="bi bi-receipt"></i> Pesanan
      </a>
    </nav>
    <div class="admin-div" style="border-top:1px solid #f0f0f0;margin:8px 0"></div>
    <nav class="nav nav-pills flex-column">
      <a class="nav-link" href="/"><i class="bi bi-globe"></i> Lihat situs</a>
      <a class="nav-link logout" href="/logout"><i class="bi bi-box-arrow-right"></i> Keluar</a>
    </nav>
  </aside>
  <div class="admin-scrim" id="panelScrim"></div>
  <main class="admin-main">
    {% block admin_content %}

    {% endblock %}
  </main>
{% endblock %}
